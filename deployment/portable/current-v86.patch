+'use client';
+import {useEffect,useState} from 'react';
+export default function LoginForm({returnTo,oauthError}:{returnTo:string;oauthError:boolean}) {
+  const [email,setEmail]=useState(''),[password,setPassword]=useState(''),[busy,setBusy]=useState(false),[message,setMessage]=useState(oauthError?'تعذر إتمام الدخول. حاول مجددًا.':''),[providers,setProviders]=useState<Record<string,boolean>>({});
+  useEffect(()=>{fetch('/api/independent/oauth/providers',{cache:'no-store'}).then(r=>r.json()).then(d=>setProviders(d.providers||{})).catch(()=>{});},[]);
+  async function submit(action:string,provider?:string) {
+    if(busy)return;setBusy(true);setMessage('');
+    try {
+      const r=await fetch('/api/independent/'+action,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify(provider?{provider}:{email,password}),signal:AbortSignal.timeout(15000)});
+      const data=await r.json();if(!r.ok)throw Error(data.error);
+      if(provider){const u=new URL(data.url);if(!/^https:\/\/[a-z0-9]{20}\.supabase\.co$/.test(u.origin)||u.pathname!=='/auth/v1/authorize'||u.searchParams.get('provider')!==provider||u.searchParams.get('redirect_to')!==location.origin+'/auth/callback')throw Error();location.assign(u.href);}
+      else if(action==='signin'){setPassword('');location.assign(returnTo);}
+      else {setPassword('');setMessage('تحقق من بريدك لتأكيد الحساب، ثم سجّل الدخول.');}
+    } catch(error){const code=error instanceof Error?error.message:'';setMessage(code==='email_confirmation_required'?'أكد بريدك الإلكتروني أولًا.':code==='rate_limited'?'انتظر دقيقة قبل المحاولة مجددًا.':'تعذر تسجيل الدخول. تحقق من بياناتك أو حاول لاحقًا.');}
+    finally {setBusy(false);}
+  }
+  return <><form onSubmit={e=>{e.preventDefault();void submit('signin');}} style={{display:'grid',gap:16}}>
+    <label>البريد الإلكتروني<input required type="email" autoComplete="email" dir="ltr" value={email} onChange={e=>setEmail(e.target.value)} disabled={busy} style={{display:'block',width:'100%',padding:12}}/></label>
+    <label>كلمة المرور<input required type="password" autoComplete="current-password" value={password} onChange={e=>setPassword(e.target.value)} disabled={busy} style={{display:'block',width:'100%',padding:12}}/></label>
+    <button type="submit" disabled={busy}>تسجيل الدخول</button><button type="button" disabled={busy||password.length<10||!email} onClick={()=>void submit('signup')}>إنشاء حساب</button>
+    {['google','apple'].filter(p=>providers[p]).map(p=><button key={p} type="button" disabled={busy} onClick={()=>void submit('oauth/start',p)}>الدخول باستخدام {p==='google'?'Google':'Apple'}</button>)}
+  </form><p role="status" aria-live="polite">{message}</p></>;
+}
