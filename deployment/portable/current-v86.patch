@@ -0,0 +1,16 @@
+'use client';
+import {useEffect} from 'react';
+export default function PortableSession({signedIn}:{signedIn:boolean}) {
+  useEffect(()=>{
+    if(!signedIn)return;let lastActivity=Date.now(),lastRefresh=Date.now(),pending=false,stopped=false;
+    let controller:AbortController|undefined;
+    const stop=()=>{stopped=true;controller?.abort();};
+    const leaving=(event:MouseEvent)=>{const link=(event.target as Element)?.closest?.('a');if(link && ['/logout','/signout-with-chatgpt'].includes(new URL(link.href,location.origin).pathname))stop();};
+    window.addEventListener('pedia:before-signout',stop);window.addEventListener('pagehide',stop);document.addEventListener('click',leaving,true);
+    const activity=()=>{lastActivity=Date.now();};const events=['pointerdown','keydown','touchstart','scroll'];events.forEach(n=>window.addEventListener(n,activity,{passive:true}));
+    const timer=setInterval(async()=>{if(stopped||pending||document.visibilityState!=='visible'||Date.now()-lastActivity>120000||Date.now()-lastRefresh<240000)return;pending=true;
+      controller=new AbortController();const timeout=setTimeout(()=>controller?.abort(),12000);
+      try{const r=await fetch('/api/independent/refresh',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}',signal:controller.signal});if(!stopped && r.ok)lastRefresh=Date.now();else if(!stopped && r.status===401){stop();location.replace('/logout');}}catch{}finally{clearTimeout(timeout);pending=false;controller=undefined;}},15000);
+    return()=>{stop();clearInterval(timer);events.forEach(n=>window.removeEventListener(n,activity));window.removeEventListener('pedia:before-signout',stop);window.removeEventListener('pagehide',stop);document.removeEventListener('click',leaving,true);};
+  },[signedIn]);return null;
+}
