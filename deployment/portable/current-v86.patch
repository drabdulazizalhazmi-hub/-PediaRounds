+    const {auth}=setup(altered),res=response();await assert.rejects(auth.signIn(req(),res,{email:user.email,password:'fictional'}),/sign_in_required/);assert.equal(res.getHeader('Set-Cookie'),undefined);
+  }
+});
+test('cross-origin writes rejected, refresh re-verifies, logout clears both cookies',async()=>{
+  const {auth}=setup(),res=response();
+  assert.throws(()=>auth.guard({...req(),headers:{origin:'https://different.example'}}),/same_origin_required/);
+  await auth.refresh(req(REFRESH+'='+refresh),res);
+  assert.equal((await auth.current(req(ACCESS+'='+token))).user.id,user.id);
+  await auth.signOut(req(ACCESS+'='+token),res);
+  assert.ok(res.getHeader('Set-Cookie').filter(c=>c.startsWith(ACCESS+'=')||c.startsWith(REFRESH+'=')).every(c=>c.includes('Max-Age=0')));
+});
