+  console.log(JSON.stringify({nativeNodeRuntime:true,protectedEndpointsRejectForgedIdentity:true,protectedPageRedirects:true,crossOriginWriteRejected:true,logoutClearsCookies:true,readinessBlocked:true,hostedConnections:false}));
