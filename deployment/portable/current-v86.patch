+import {getChatGPTUser} from '../../app/chatgpt-auth';
+import {portableEnvironment} from './assets.mjs';
+import {serveQuestionFigure} from '../../worker/question-figures';
+import {createSourceDocumentService} from '../source-documents.mjs';
+import {createSpeechService} from '../speech-service.mjs';
+import sourceDocuments from '../../data/source-documents.json';
+const sources=createSourceDocumentService(sourceDocuments),speech=createSpeechService();
+let scenarios:Promise<(request:Request,env:unknown)=>Promise<Response>>|undefined;
+export async function servePortable(request:Request,kind:'figures'|'documents'|'speech'|'scenario') {
+  const user=await getChatGPTUser();
+  if(!user)return Response.json({error:'Sign in required.'},{status:401,headers:{'Cache-Control':'private, no-store'}});
+  const headers=new Headers(request.headers);
+  // Strip caller-supplied platform identity before invoking existing pure service functions.
+  for(const key of [...headers.keys()])if(key.startsWith('oai-authenticated-'))headers.delete(key);
+  headers.set('oai-authenticated-user-id',user.id);headers.set('oai-authenticated-user-email',user.email);
+  const trusted=new Request(request,{headers});const env=portableEnvironment();
+  if(kind==='documents')return sources(trusted,env);
+  if(kind==='speech')return speech(trusted,env);
+  if(kind==='figures')return serveQuestionFigure(trusted,env as unknown as Parameters<typeof serveQuestionFigure>[1]);
+  scenarios ||= Promise.all([import('../../lib/question-bank'),import('../../data/arabic-scenarios.json'),import('../scenario-service.mjs')]).then(([bank,saved,service])=>service.createScenarioService({questions:bank.default.questions,savedScenarios:saved.default}));
+  return (await scenarios)(trusted,env);
+}
