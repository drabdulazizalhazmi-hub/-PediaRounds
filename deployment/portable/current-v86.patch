diff --git a/server/portable/http.mjs b/server/portable/http.mjs
new file mode 100644
index 0000000..5487d14
--- /dev/null
+++ b/server/portable/http.mjs
@@ -0,0 +1,28 @@
+import {createStudyAuth} from './auth.mjs';
+export const portableAuth=createStudyAuth();
+export const nodeRequest=request=>({method:request.method,url:request.url,headers:Object.fromEntries(request.headers),socket:{remoteAddress:'render-edge'}});
+export function nodeResponse() {
+  const values=new Map();return {setHeader:(k,v)=>values.set(k.toLowerCase(),v),getHeader:k=>values.get(k.toLowerCase()),
+    headers(){const h=new Headers({'Cache-Control':'private, no-store','Vary':'Cookie','X-Content-Type-Options':'nosniff'});for(const [k,v] of values)for(const entry of Array.isArray(v)?v:[v])h.append(k,entry);return h;}};
+}
+export async function handleAuth(request,action) {
+  const req=nodeRequest(request),res=nodeResponse();
+  try {
+    if(action==='oauth/providers'&&request.method==='GET')return Response.json(await portableAuth.oauth.providers(),{headers:res.headers()});
+    if(request.method!=='POST')return Response.json({error:'method_not_allowed'},{status:405,headers:res.headers()});
+    portableAuth.guard(req);
+    if(!/^application\/json(?:\s*;|$)/i.test(request.headers.get('content-type')||''))throw Object.assign(Error(),{status:415,code:'json_required'});
+    const reader=request.body?.getReader();let size=0;const chunks=[];
+    if(reader)try {while(true){const part=await reader.read();if(part.done)break;size+=part.value.byteLength;if(size>16000){await reader.cancel();throw Object.assign(Error(),{status:413,code:'body_too_large'});}chunks.push(part.value);}}finally{reader.releaseLock();}
+    let body;try{body=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{throw Object.assign(Error(),{status:400,code:'invalid_json'});}
+    if(!body||typeof body!=='object'||Array.isArray(body))throw Object.assign(Error(),{status:400,code:'invalid_input'});
+    let data;
+    if(action==='signin')data=await portableAuth.signIn(req,res,body);
+    else if(action==='signup')data=await portableAuth.signUp(req,body);
+    else if(action==='signout')data=await portableAuth.signOut(req,res);
+    else if(action==='refresh')data=await portableAuth.refresh(req,res);
+    else if(action==='oauth/start')data=await portableAuth.oauth.begin(req,res,body);
+    else return Response.json({error:'not_found'},{status:404,headers:res.headers()});
+    return Response.json(data,{headers:res.headers()});
+  } catch(error){return Response.json({error:error.code||'auth_unavailable'},{status:error.status||503,headers:res.headers()});}
+}
diff --git a/server/portable/oauth.mjs b/server/portable/oauth.mjs
new file mode 100644
index 0000000..d8d8e12
--- /dev/null
+++ b/server/portable/oauth.mjs
@@ -0,0 +1,94 @@
+/** Google/Apple login through Supabase Auth; no provider secret or token reaches JS. */
+import {createHash, randomBytes} from 'node:crypto';
+
+export const OAUTH_COOKIE = '__Host-pediarounds_oauth';
+export const OAUTH_CALLBACK = '/auth/callback';
+const PROVIDERS = new Set(['google', 'apple']);
+const TTL = 600000;
+const fail = (status, code) => Object.assign(new Error(code), {status, code});
+
+function appendCookie(res, value) {
+  const existing = res.getHeader('Set-Cookie');
+  res.setHeader('Set-Cookie', [...(Array.isArray(existing) ? existing : existing ? [existing] : []), value]);
+}
+function pendingValue(req) {
+  const values = String(req.headers.cookie || '').split(';').map(v => v.trim())
+    .filter(v => v.startsWith(OAUTH_COOKIE + '='));
+  if (values.length !== 1) return '';
+  const value = values[0].slice(OAUTH_COOKIE.length + 1);
+  return /^[A-Za-z0-9_-]{40,1024}$/.test(value) ? value : '';
+}
+function readPending(req, now) {
+  try {
+    const data = JSON.parse(Buffer.from(pendingValue(req), 'base64url').toString('utf8'));
+    if (data?.version !== 1 || !PROVIDERS.has(data.provider) ||
+        !/^[A-Za-z0-9_-]{43}$/.test(data.verifier || '') ||
+        !Number.isSafeInteger(data.createdAt) || data.createdAt > now || now - data.createdAt >= TTL) return null;
+    return data;
+  } catch { return null; }
+}
+
+export function createStudyOAuth({origin, url, configured, remote, establish, guard, limit, now = Date.now}) {
+  let cached = null, pending = null, cachedAt = 0;
+  function clear(res) {
+    appendCookie(res, OAUTH_COOKIE + '=; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=0');
+  }
+  async function providers() {
+    if (!configured) return {configured: false, providers: {google: false, apple: false}, authorizationOrigin: null};
+    if (cached && now() - cachedAt < 30000) return cached;
+    if (pending) return pending;
+    pending = (async () => {
+      const data = await remote('/settings');
+      if (!data || typeof data.external?.google !== 'boolean' || typeof data.external?.apple !== 'boolean')
+        throw fail(503, 'oauth_settings_unavailable');
+      // Public capability flags only. Never forward the entire settings response.
+      cached = {configured: true, providers: {google: data.external.google, apple: data.external.apple}, authorizationOrigin: url};
+      cachedAt = now();
+      return cached;
+    })();
+    try { return await pending; } finally { pending = null; }
+  }
+  async function begin(req, res, data) {
+    if (req.method !== 'POST') throw fail(405, 'method_not_allowed');
+    guard(req);
+    if (!data || Array.isArray(data) || Object.keys(data).length !== 1 || !PROVIDERS.has(data.provider))
+      throw fail(400, 'invalid_oauth_provider');
+    if (!configured || new URL(origin).protocol !== 'https:') throw fail(503, 'external_backend_not_configured');
+    limit(req, 'oauth');
+    const settings = await providers();
+    if (!settings.providers[data.provider]) throw fail(409, 'oauth_provider_not_enabled');
+    const verifier = randomBytes(32).toString('base64url');
+    const challenge = createHash('sha256').update(verifier).digest('base64url');
+    const transaction = Buffer.from(JSON.stringify({version: 1, provider: data.provider, verifier, createdAt: now()})).toString('base64url');
+    appendCookie(res, OAUTH_COOKIE + '=' + transaction + '; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=600');
+    const authorization = new URL(url + '/auth/v1/authorize');
+    authorization.searchParams.set('provider', data.provider);
+    authorization.searchParams.set('redirect_to', origin + OAUTH_CALLBACK);
+    authorization.searchParams.set('code_challenge', challenge);
+    authorization.searchParams.set('code_challenge_method', 's256');
+    authorization.searchParams.set('scopes', data.provider === 'google' ? 'openid email profile' : 'email');
+    if (data.provider === 'google') authorization.searchParams.set('prompt', 'select_account');
+    return {provider: data.provider, url: authorization.href};
+  }
+  async function callback(req, res) {
+    if (req.method !== 'GET') throw fail(405, 'method_not_allowed');
+    try {
+      const transaction = readPending(req, now());
+      if (!transaction) throw fail(400, 'oauth_expired');
+      const query = new URL(req.url, origin).searchParams;
+      if (query.has('error')) throw fail(400, query.get('error') === 'access_denied' ? 'oauth_cancelled' : 'oauth_failed');
+      const codes = query.getAll('code');
+      if (codes.length !== 1 || !/^[A-Za-z0-9_-]{16,512}$/.test(codes[0])) throw fail(400, 'oauth_failed');
+      limit(req, 'oauth-callback');
+      // Supabase owns and validates provider OAuth state. PKCE binds its returned
+      // one-use auth code to the browser's HttpOnly verifier, preventing login CSRF.
+      const data = await remote('/token?grant_type=pkce', undefined, {auth_code: codes[0], code_verifier: transaction.verifier});
+      await establish(res, data); // Re-fetch /user server-side before issuing cookies.
+      return '/questions'; // Ignore all caller-controlled next/redirect/provider values.
+    } catch (error) {
+      const allowed = new Set(['oauth_expired', 'oauth_cancelled', 'oauth_failed', 'rate_limited', 'auth_unavailable', 'external_backend_not_configured']);
+      return '/login?auth_error=' + (allowed.has(error.code) ? error.code : 'oauth_failed');
+    } finally { clear(res); }
+  }
+  return {providers, begin, callback, clear, hasPending: req => !!pendingValue(req)};
+}
diff --git a/server/portable/postgres.mjs b/server/portable/postgres.mjs
new file mode 100644
index 0000000..daee8f6
--- /dev/null
+++ b/server/portable/postgres.mjs
@@ -0,0 +1,89 @@
+/** PostgreSQL implementation of the narrow D1 API used by PediaRounds v86. */
+const UUID=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+let poolPromise;
+async function pool() {
+  if(!poolPromise)poolPromise=(async()=>{
+    const value=process.env.PEDIAROUNDS_DATABASE_URL;
+    if(!value)throw Error('portable_database_not_configured');
+    const url=new URL(value);
+    if(!['postgres:','postgresql:'].includes(url.protocol)||!url.hostname)throw Error('invalid_database_configuration');
+    for(const key of ['sslmode','sslcert','sslkey','sslrootcert','sslnegotiation'])url.searchParams.delete(key);
+    const {Pool}=await import('pg');
+    const p=new Pool({connectionString:url.href,max:5,connectionTimeoutMillis:7000,idleTimeoutMillis:30000,
+      ssl:{rejectUnauthorized:true,...(process.env.PEDIAROUNDS_DATABASE_CA?{ca:process.env.PEDIAROUNDS_DATABASE_CA}:{})}});
+    p.on('error',()=>console.error('portable_database_connection_failed'));
+    return p;
+  })().catch(error=>{poolPromise=undefined;throw error;});
+  return poolPromise;
+}
+export function translateQuery(sql) {
+  let text='',position=0,quote=null;
+  for(let i=0;i<sql.length;i++) {
+    const c=sql[i];
+    if(quote) {text+=c;if(c===quote){if(sql[i+1]===quote){text+=sql[++i];}else quote=null;}continue;}
+    if(c==="'"||c==='"'){quote=c;text+=c;continue;}
+    if(c===';' || c==='$' || c==='-'&&sql[i+1]==='-' || c==='/'&&sql[i+1]==='*')throw Error('unsupported_query_syntax');
+    text+=c==='?'?'$'+(++position):c;
+  }
+  if(quote)throw Error('unterminated_query_literal');
+  // PostgreSQL folds unquoted identifiers; the current handlers expect camelCase aliases.
+  text=text.replace(/\bAS (questionId|completedAt|updatedAt)\b/g,'AS "$1"');
+  // SQLite uses numeric flags for these two annotation-update conditions.
+  text=text.replace(/\bCASE WHEN (\$\d+) THEN/g,'CASE WHEN $1::integer <> 0 THEN');
+  if(!/^\s*(SELECT|INSERT|UPDATE|DELETE)\b/i.test(text))throw Error('unsupported_query_operation');
+  return {text,parameters:position};
+}
+function result(value) {
+  const bigints=new Set((value.fields||[]).filter(f=>f.dataTypeID===20).map(f=>f.name));
+  const rows=value.rows.map(row=>Object.fromEntries(Object.entries(row).map(([key,v])=>{
+    if(bigints.has(key)&&v!==null){const n=Number(v);if(!Number.isSafeInteger(n))throw Error('unsafe_database_integer');return [key,n];}
+    return [key,v];
+  })));
+  return {success:true,results:rows,meta:{changes:['SELECT','SHOW'].includes(value.command)?0:value.rowCount??0}};
+}
+async function transaction(externalId,expectedId,fn,providedPool) {
+  if(!UUID.test(externalId))throw Error('invalid_verified_identity');
+  const p=providedPool||await pool(),client=await p.connect();let begun=false,broken=false;
+  try {
+    await client.query('BEGIN');begun=true;
+    const role=await client.query('SELECT rolsuper,rolbypassrls FROM pg_roles WHERE rolname=current_user');
+    if(role.rows[0]?.rolsuper!==false || role.rows[0]?.rolbypassrls!==false)throw Error('least_privilege_database_role_required');
+    await client.query("SET LOCAL search_path = pg_catalog, pediarounds_portable");
+    await client.query("SET LOCAL statement_timeout = '8s'");
+    await client.query("SELECT set_config('pediarounds.external_user_id',$1,true)",[externalId]);
+    const linked=await client.query('SELECT legacy_user_id FROM pediarounds_portable.account_links WHERE external_user_id=$1::uuid',[externalId]);
+    const id=linked.rows[0]?.legacy_user_id||externalId;
+    if(expectedId && expectedId!==id)throw Error('account_mapping_changed');
+    await client.query("SELECT set_config('pediarounds.user_id',$1,true)",[id]);
+    const value=await fn(client,id);
+    await client.query('COMMIT');begun=false;return value;
+  } catch(error) {
+    if(begun)try{await client.query('ROLLBACK');}catch{broken=true;}
+    throw error;
+  } finally {client.release(broken);}
+}
+export async function resolveAccount(externalId,providedPool) {
+  return transaction(externalId,null,async(_client,id)=>id,providedPool);
+}
+export function postgresD1(user,providedPool) {
+  if(!user || !UUID.test(user.externalId||''))throw Error('verified_identity_required');
+  const statements=new WeakMap();
+  async function execute(list) {
+    return transaction(user.externalId,user.id,async client=>{
+      const output=[];
+      for(const statement of list){const spec=statements.get(statement);if(!spec)throw Error('foreign_statement');output.push(result(await client.query(spec.text,spec.values)));}
+      return output;
+    },providedPool);
+  }
+  function prepared(sql,values=[]) {
+    const {text,parameters}=translateQuery(sql);
+    const item={
+      bind(...args){if(args.length!==parameters)throw Error('parameter_count_mismatch');return prepared(sql,args);},
+      async all(){return (await execute([item]))[0];},
+      async first(){return (await item.all()).results[0]??null;},
+      async run(){return (await execute([item]))[0];}
+    };
+    statements.set(item,{text,values});return item;
+  }
+  return {prepare:prepared,batch:execute};
+}
