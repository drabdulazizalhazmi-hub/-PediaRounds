+const origin='https://portable.example.test',token='fictional-access-token-12345',refresh='fictional-refresh-token';
+const user={id:'11111111-1111-4111-8111-111111111111',email:'fictional@example.test',role:'authenticated',email_confirmed_at:'2026-09-12'};
+const req=(cookie='')=>({method:'POST',headers:{origin,cookie},socket:{remoteAddress:'test'}});
+const response=()=>({values:new Map(),setHeader(k,v){this.values.set(k,v);},getHeader(k){return this.values.get(k);}});
+function setup(verified=user){const calls=[];return {calls,auth:createStudyAuth({env:{PEDIAROUNDS_APP_ORIGIN:origin,PEDIAROUNDS_EXTERNAL_BACKEND:'enabled',PEDIAROUNDS_SUPABASE_URL:'https://abcdefghijklmnopqrst.supabase.co',PEDIAROUNDS_SUPABASE_PUBLISHABLE_KEY:'sb_publishable_fictional'},fetcher:async(url,init)=>{
+  calls.push({url,init});
+  if(url.endsWith('/user'))return Response.json(verified);
+  if(url.includes('/logout'))return new Response(null,{status:204});
+  return Response.json({access_token:token,refresh_token:refresh,user:{id:'untrusted-token-user'}});
+}})};}
+test('login verifies identity with provider and keeps tokens out of response JSON',async()=>{
+  const {auth,calls}=setup(),res=response();
+  assert.deepEqual(await auth.signIn(req(),res,{email:user.email,password:'fictional-password'}),{user:{id:user.id,email:user.email}});
+  assert.ok(calls.some(c=>c.url.endsWith('/user')));
+  for(const cookie of res.getHeader('Set-Cookie'))assert.match(cookie,/HttpOnly; Secure; SameSite=Lax; Max-Age=600/);
+});
+test('platform headers and duplicate cookies cannot supply an identity',async()=>{
+  const {auth}=setup();
+  await assert.rejects(auth.current({...req(),headers:{'oai-authenticated-user-id':user.id}}),/sign_in_required/);
+  await assert.rejects(auth.current(req(ACCESS+'='+token+'; '+ACCESS+'='+token)),/sign_in_required/);
+});
+test('unverified or anonymous provider identity is rejected before cookies are issued',async()=>{
